# Copy to backend/.env for local development. Never commit real values.
# Outside ENVIRONMENT=development the API refuses to start without real secrets (task 032).

ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clickshield
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/clickshield
REDIS_URL=redis://localhost:6379/0

# JWT signing key, at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-me>

# Fernet keys for Google refresh tokens, comma-separated, newest first (rotation):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=<generate-me>

# Google OAuth client of your Google Cloud project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A dashboard route (compose: :8080; `npm run dev`: http://localhost:5173/google/callback). Register it in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/google/callback
GOOGLE_ADS_DRY_RUN=true
# Google Ads API version (default v24; Google supports each version for about a year).
# GOOGLE_ADS_API_VERSION=v24
# Legacy and optional: Google retired developer tokens (2026-09-09). Leave unset; it is only sent if set.
# GOOGLE_DEVELOPER_TOKEN=

IPINFO_API_KEY=

TRACKING_SNIPPET_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_APP_URL=http://localhost:5173

# Development seed (development only). Leave the password empty to get a generated one in the log.
DEFAULT_ADMIN_EMAIL=admin@localhost.test
DEFAULT_ADMIN_PASSWORD=

# Alert / invitation email: console (logged) or smtp
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@clickshield.local

# Retention: dry run until you have reviewed the counts in the audit log
RETENTION_DRY_RUN=true
